" Neovim configuration for comprehensive test
set number
set relativenumber
set tabstop=2
set shiftwidth=2
set expandtab
set autoindent
set smartindent

" Enable syntax highlighting
syntax enable

" Color scheme
colorscheme default

" Key mappings
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>

